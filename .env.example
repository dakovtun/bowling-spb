# Ключ Яндекс Карт (продукт "JavaScript API и HTTP Геокодер"),
# получить: https://developer.tech.yandex.ru/services/
# Пока переменная не задана, сайт показывает декоративную заглушку карты.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# --- Хранилище данных о клубах (Redis) ---
# Каталог клубов хранится в Redis, а не в статическом файле — так с ним
# может работать админка (/admin). Подключите интеграцию в Vercel:
#   Vercel Dashboard → Storage → Marketplace Database Providers → Upstash (Redis)
# либо создайте базу напрямую на upstash.com. Затем скопируйте переменные
# окружения (кнопка "Copy Snippet" / ".env.local" на странице базы).
# Поддерживаются оба варианта названий — используйте те, что даст ваша интеграция:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# или, если интеграция называет их иначе:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Без этих переменных сайт продолжит работать на встроенных SEED_CLUBS
# (см. lib/clubs.ts) — это нормально для локальной разработки, но админка
# в этом случае не сможет сохранять изменения.
#
# После первого запуска с заполненными переменными выполните:
#   npm run db:seed
# — это одноразово перенесёт SEED_CLUBS в хранилище.

# --- Админка (/admin) ---
# Пароль для входа в админку. Один общий аккаунт, без логина/email.
ADMIN_PASSWORD=

# Секрет для подписи сессионной куки админки. Любая длинная случайная строка,
# например: openssl rand -hex 32
ADMIN_SESSION_SECRET=
